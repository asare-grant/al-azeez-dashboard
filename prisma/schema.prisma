model ReportCardActivity {
  id Int @id @default(autoincrement())

  reportCardId Int

  type ReportCardActivityType

  actorId   String?
  actorRole String?
  actorName String?

  title       String
  description String?

  note String?

  metadata Json?

  createdAt DateTime @default(now())

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  @@index([reportCardId, createdAt])
  @@index([type])
  @@index([actorId])
}
