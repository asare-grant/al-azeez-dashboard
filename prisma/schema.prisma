// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  studentID   String       @unique
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String?
  parent      Parent?      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  results     Result[]

  assessmentAttempts AssessmentAttempt[]

  birthday   DateTime
  feeMasters FeeMaster[]

  studentType  String // "new" or "old"
  boardingType String // "boarder" or "day"

  feedingFeeStudent  FeedingFeeStudent?
  feedingFeePayments FeedingFeePayment[]

  busFeeStudent  BusFeeStudent?
  busFeePayments BusFeePayment[]
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  teacherID String    @unique
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime

 reviewedAssessmentAttempts AssessmentAttempt[] @relation("AssessmentAttemptReviewer")
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id    Int    @id @default(autoincrement())
  level String @unique

  students      Student[]
  classess      Class[]
  feeStructures FeeStructure[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  events        Event[]
  announcements Announcement[]
  feeStructures FeeStructure[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  classId   Int
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  assessments Assessment[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Result {
  id Int @id @default(autoincrement())

  score      Float
  totalMarks Float?
  percentage Float?
  grade      String?
  remarks    String?

  type ResultType

  examId Int?
  exam   Exam? @relation(fields: [examId], references: [id], onDelete: Cascade)

  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  assessmentId Int?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  assessmentAttemptId Int?               @unique
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([type])
  @@index([assessmentId])
  @@index([studentId, assessmentId])
  @@index([studentId, type, createdAt])
}

model Assessment {
  id           Int     @id @default(autoincrement())
  title        String
  instructions String?

  startDate DateTime
  dueDate   DateTime

  durationMinutes Int?
  passMarkPercent Int  @default(50)
  maxAttempts     Int  @default(1)

  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  allowBacktrack   Boolean @default(true)
  allowUnanswered  Boolean @default(true)

  showInstantResult  Boolean @default(true)
  showCorrectAnswers Boolean @default(false)
  showExplanations   Boolean @default(false)

  autoSubmit Boolean @default(true)

  status AssessmentStatus @default(DRAFT)

  totalMarks    Int @default(0)
  questionCount Int @default(0)

  publishedAt DateTime?
  closedAt    DateTime?

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
  results   Result[]

  academicYear String?

  termId Int?
  term   SchoolTerm? @relation(fields: [termId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([lessonId, status])
  @@index([termId])
  @@index([academicYear])
}

model AssessmentQuestion {
  id Int @id @default(autoincrement())

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionText String
  imageUrl     String?
  explanation  String?

  marks    Int @default(1)
  position Int

  options AssessmentOption[]
  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, position])
  @@index([assessmentId])
}

model AssessmentOption {
  id Int @id @default(autoincrement())

  questionId Int
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String
  imageUrl   String?

  isCorrect Boolean @default(false)
  position  Int

  selectedAnswers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
}

model AssessmentAttempt {
  id Int @id @default(autoincrement())

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attemptNumber Int @default(1)

  status AssessmentAttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  expiresAt   DateTime?

  lastActivityAt DateTime @default(now())

  timeSpentSeconds Int @default(0)

  score           Int?
  totalMarks      Int?
  percentage      Float?
  correctCount    Int?
  incorrectCount  Int?
  unansweredCount Int?

  answers AssessmentAnswer[]
  result  Result?

  teacherFeedback String?
  reviewedAt      DateTime?
  reviewedById    String?

  reviewedBy Teacher? @relation("AssessmentAttemptReviewer",fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
  @@index([assessmentId, status])
}

model AssessmentAnswer {
  id Int @id @default(autoincrement())

  attemptId Int
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId Int?
  selectedOption   AssessmentOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  isCorrect    Boolean?
  marksAwarded Int      @default(0)

  flagged Boolean @default(false)

  answeredAt       DateTime?
  timeSpentSeconds Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean
  day     Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime @default(now()) // NEW
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model FeeCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  types FeeType[]
}

model FeeType {
  id         Int            @id @default(autoincrement())
  name       String
  categoryId Int
  category   FeeCategory    @relation(fields: [categoryId], references: [id])
  structures FeeStructure[]
}

model FeeStructure {
  id     Int   @id @default(autoincrement())
  amount Float

  studentType  String // "new" or "old"
  boardingType String // "boarder" or "day"

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  gradeId Int?
  grade   Grade? @relation(fields: [gradeId], references: [id])

  typeId Int
  type   FeeType @relation(fields: [typeId], references: [id])
  fees   Fee[]
}

model FeeMaster {
  id        Int     @id @default(autoincrement())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  term         String
  academicYear String

  totalAmount Float
  status      FeeStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  details  Fee[]
  payments FeePayment[]
}

model Fee {
  id       Int       @id @default(autoincrement())
  masterId Int
  master   FeeMaster @relation(fields: [masterId], references: [id])

  structureId Int
  structure   FeeStructure @relation(fields: [structureId], references: [id])

  amount Float
}

model FeePayment {
  id       Int       @id @default(autoincrement())
  masterId Int
  master   FeeMaster @relation(fields: [masterId], references: [id])

  amount Float
  date   DateTime      @default(now())
  method PaymentMethod
}

model FeedingFeeStudent {
  id        Int     @id @default(autoincrement())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model FeedingFeePayment {
  id     Int      @id @default(autoincrement())
  amount Float
  date   DateTime
  day    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model BusFeeStudent {
  id        Int     @id @default(autoincrement())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BusFeePayment {
  id     Int      @id @default(autoincrement())
  amount Float
  date   DateTime
  day    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum ResultType {
  EXAM
  ASSIGNMENT
  ASSESSMENT
}

enum FeeStatus {
  PAID
  PARTIAL
  PENDING
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CHEQUE
}

model SchoolTerm {
  id        Int      @id @default(autoincrement())
  name      TermName
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum AssessmentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTING
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  CANCELLED
}
