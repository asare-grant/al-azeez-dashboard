// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  studentID   String       @unique
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String?
  parent      Parent?      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  results     Result[]

  assessmentAttempts AssessmentAttempt[]

  reportCards ReportCard[]

  birthday   DateTime
  feeMasters FeeMaster[]

  studentType  String // "new" or "old"
  boardingType String // "boarder" or "day"

  feedingFeeStudent  FeedingFeeStudent?
  feedingFeePayments FeedingFeePayment[]

  busFeeStudent  BusFeeStudent?
  busFeePayments BusFeePayment[]
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  teacherID String    @unique
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime

  reviewedAssessmentAttempts AssessmentAttempt[] @relation("AssessmentAttemptReviewer")
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id    Int    @id @default(autoincrement())
  level String @unique

  students      Student[]
  classess      Class[]
  feeStructures FeeStructure[]

  academicWeightings AcademicWeighting[]

  reportCards ReportCard[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  events        Event[]
  announcements Announcement[]
  feeStructures FeeStructure[]

  reportCards ReportCard[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]

  reportCardSubjects ReportCardSubject[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  classId   Int
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  assessments Assessment[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  academicYear String?

  termId Int?

  term SchoolTerm? @relation("ExamSchoolTerm", fields: [termId], references: [id], onDelete: Restrict)

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]

  @@index([lessonId])
  @@index([academicYear])
  @@index([termId])
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]

  academicYear String?

  termId Int?
  term   SchoolTerm? @relation(fields: [termId], references: [id], onDelete: Restrict)
}

model Result {
  id Int @id @default(autoincrement())

  score      Float
  totalMarks Float?
  percentage Float?
  grade      String?
  remarks    String?

  type ResultType

  examId Int?
  exam   Exam? @relation(fields: [examId], references: [id], onDelete: Cascade)

  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  assessmentId Int?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  assessmentAttemptId Int?               @unique
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([type])
  @@index([assessmentId])
  @@index([studentId, assessmentId])
  @@index([studentId, type, createdAt])
}

model Assessment {
  id           Int     @id @default(autoincrement())
  title        String
  instructions String?

  startDate DateTime
  dueDate   DateTime

  durationMinutes Int?
  passMarkPercent Int  @default(50)
  maxAttempts     Int  @default(1)

  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  allowBacktrack   Boolean @default(true)
  allowUnanswered  Boolean @default(true)

  showInstantResult  Boolean @default(true)
  showCorrectAnswers Boolean @default(false)
  showExplanations   Boolean @default(false)

  autoSubmit Boolean @default(true)

  status AssessmentStatus @default(DRAFT)

  totalMarks    Int @default(0)
  questionCount Int @default(0)

  publishedAt DateTime?
  closedAt    DateTime?

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
  results   Result[]

  auditLogs AssessmentAuditLog[]

  academicYear String?

  termId Int?
  term   SchoolTerm? @relation(fields: [termId], references: [id], onDelete: Restrict)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([lessonId, status])
  @@index([termId])
  @@index([academicYear])
}

model AssessmentQuestion {
  id Int @id @default(autoincrement())

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionText String
  imageUrl     String?
  explanation  String?

  marks    Int @default(1)
  position Int

  options AssessmentOption[]
  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, position])
  @@index([assessmentId])
}

model AssessmentOption {
  id Int @id @default(autoincrement())

  questionId Int
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String
  imageUrl   String?

  isCorrect Boolean @default(false)
  position  Int

  selectedAnswers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
}

model AssessmentAttempt {
  id            Int                     @id @default(autoincrement())
  attemptNumber Int                     @default(1)
  status        AssessmentAttemptStatus @default(IN_PROGRESS)

  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  expiresAt      DateTime?
  lastActivityAt DateTime  @default(now())

  timeSpentSeconds Int @default(0)

  score Int?

  totalMarks      Int?
  percentage      Float?
  correctCount    Int?
  incorrectCount  Int?
  unansweredCount Int?

  // Navigation progress
  currentQuestionIndex Int @default(0)
  highestQuestionIndex Int @default(0)

  // Optimistic concurrency
  version Int @default(1)

  // Duplicate-tab protection
  activeSessionId     String?
  activeSessionSeenAt DateTime?

  // Submission locking and recovery
  submissionToken     String?   @unique
  submissionStartedAt DateTime?
  failureReason       String?

  // Teacher review
  teacherFeedback String?
  reviewedAt      DateTime?
  reviewedById    String?

  reviewedBy Teacher? @relation("AssessmentAttemptReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers   AssessmentAnswer[]
  result    Result?
  auditLogs AssessmentAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
  @@index([assessmentId, studentId])
  @@index([assessmentId, status])
  @@index([studentId, status])
  @@index([status, expiresAt])
  @@index([activeSessionSeenAt])
  @@index([submittedAt])
  @@index([reviewedById])
  @@index([submissionToken])
}

model AssessmentAnswer {
  id Int @id @default(autoincrement())

  attemptId Int
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId Int?
  selectedOption   AssessmentOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  flagged Boolean @default(false)

  isCorrect    Boolean?
  marksAwarded Int      @default(0)

  answeredAt       DateTime?
  timeSpentSeconds Int       @default(0)

  // Reject stale answer writes
  version Int @default(1)

  // Last client request successfully applied
  clientMutationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@index([attemptId, updatedAt])
}

model AssessmentAuditLog {
  id Int @id @default(autoincrement())

  action AssessmentAuditAction

  actorId   String?
  actorRole String?

  assessmentId Int?
  attemptId    Int?
  studentId    String?

  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  attempt AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([assessmentId, createdAt])
  @@index([attemptId, createdAt])
  @@index([studentId, createdAt])
  @@index([action, createdAt])
}

model AssessmentJobLock {
  id String @id

  lockedAt  DateTime
  lockedBy  String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model AssessmentRateLimit {
  key String @id

  count       Int
  windowStart DateTime
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean
  day     Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime @default(now()) // NEW
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model FeeCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  types FeeType[]
}

model FeeType {
  id         Int            @id @default(autoincrement())
  name       String
  categoryId Int
  category   FeeCategory    @relation(fields: [categoryId], references: [id])
  structures FeeStructure[]
}

model FeeStructure {
  id     Int   @id @default(autoincrement())
  amount Float

  studentType  String // "new" or "old"
  boardingType String // "boarder" or "day"

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  gradeId Int?
  grade   Grade? @relation(fields: [gradeId], references: [id])

  typeId Int
  type   FeeType @relation(fields: [typeId], references: [id])
  fees   Fee[]
}

model FeeMaster {
  id        Int     @id @default(autoincrement())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  term         String
  academicYear String

  totalAmount Float
  status      FeeStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  details  Fee[]
  payments FeePayment[]
}

model Fee {
  id       Int       @id @default(autoincrement())
  masterId Int
  master   FeeMaster @relation(fields: [masterId], references: [id])

  structureId Int
  structure   FeeStructure @relation(fields: [structureId], references: [id])

  amount Float
}

model FeePayment {
  id       Int       @id @default(autoincrement())
  masterId Int
  master   FeeMaster @relation(fields: [masterId], references: [id])

  amount Float
  date   DateTime      @default(now())
  method PaymentMethod
}

model FeedingFeeStudent {
  id        Int     @id @default(autoincrement())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model FeedingFeePayment {
  id     Int      @id @default(autoincrement())
  amount Float
  date   DateTime
  day    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model BusFeeStudent {
  id        Int     @id @default(autoincrement())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BusFeePayment {
  id     Int      @id @default(autoincrement())
  amount Float
  date   DateTime
  day    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])
}


model Notification {
  id Int @id @default(autoincrement())

  title   String
  message String
  type    NotificationType

  recipientId   String
  recipientRole String

  actionUrl String?

  readAt DateTime?

  assessmentId Int?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([assessmentId])
}

model NotificationEvent {
  id Int @id @default(autoincrement())

  /* -------------------------------------------------------- */
  /*                        EVENT TYPE                        */
  /* -------------------------------------------------------- */

  type     NotificationType
  category NotificationCategory

  priority NotificationPriority @default(NORMAL)

  /* -------------------------------------------------------- */
  /*                       EVENT CONTENT                      */
  /* -------------------------------------------------------- */

  title   String
  message String

  actionUrl String?

  /* -------------------------------------------------------- */
  /*                      SOURCE ENTITY                       */
  /* -------------------------------------------------------- */

  entityType NotificationEntityType?
  entityId   String?

  /*
   * Optional deduplication key.
   *
   * Example:
   * assessment:42:due-soon:24h
   *
   * This prevents recurring/scheduled jobs from
   * creating the same logical event repeatedly.
   */
  dedupeKey String? @unique

  /* -------------------------------------------------------- */
  /*                         ACTOR                            */
  /* -------------------------------------------------------- */

  actorId   String?
  actorRole String?
  actorName String?

  /*
   * Flexible event payload for future modules.
   *
   * Example:
   * {
   *   "reportCardId": 12,
   *   "studentId": "...",
   *   "classId": 20
   * }
   */
  metadata Json?

  /* -------------------------------------------------------- */
  /*                       DELIVERIES                         */
  /* -------------------------------------------------------- */

  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}


enum NotificationCategory {
  ASSESSMENT
  REPORT_CARD
  ATTENDANCE
  ACADEMIC
  FINANCE
  ANNOUNCEMENT
  SYSTEM
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  /* -------------------------------------------------------- */
  /*                       ASSESSMENTS                        */
  /* -------------------------------------------------------- */

  ASSESSMENT_CREATED
  ASSESSMENT_SCHEDULED
  ASSESSMENT_PUBLISHED
  ASSESSMENT_DUE_SOON
  ASSESSMENT_SUBMITTED
  ASSESSMENT_RESULT_READY
  ASSESSMENT_FEEDBACK_ADDED

  /* -------------------------------------------------------- */
  /*                       REPORT CARDS                       */
  /* -------------------------------------------------------- */

  REPORT_CARD_GENERATED
  REPORT_CARD_REGENERATED
  REPORT_CARD_SUBMITTED
  REPORT_CARD_CHANGES_REQUESTED
  REPORT_CARD_APPROVED
  REPORT_CARD_REOPENED
  REPORT_CARD_PUBLISHED
  REPORT_CARD_ARCHIVED
  REPORT_CARD_STALE

  /* -------------------------------------------------------- */
  /*                        ATTENDANCE                        */
  /* -------------------------------------------------------- */

  ATTENDANCE_UPDATED
  ATTENDANCE_INCOMPLETE
  ATTENDANCE_REPORT_STALE

  /* -------------------------------------------------------- */
  /*                      ACADEMIC SETUP                      */
  /* -------------------------------------------------------- */

  ACADEMIC_TERM_UPDATED
  ACADEMIC_WEIGHTING_UPDATED
  GRADING_SCALE_UPDATED

  /* -------------------------------------------------------- */
  /*                         FINANCE                          */
  /* -------------------------------------------------------- */

  FEE_ASSIGNED
  FEE_PAYMENT_RECEIVED
  FEE_PAYMENT_CONFIRMED
  FEE_BALANCE_DUE

  /* -------------------------------------------------------- */
  /*                      ANNOUNCEMENTS                       */
  /* -------------------------------------------------------- */

  ANNOUNCEMENT_PUBLISHED

  /* -------------------------------------------------------- */
  /*                         SYSTEM                           */
  /* -------------------------------------------------------- */

  SYSTEM_ALERT
  GENERAL
}

enum NotificationEntityType {
  ASSESSMENT
  REPORT_CARD
  ATTENDANCE
  RESULT
  ASSIGNMENT
  EXAM
  SCHOOL_TERM
  ACADEMIC_WEIGHTING
  GRADING_SCALE
  FEE
  PAYMENT
  ANNOUNCEMENT
  STUDENT
  CLASS
  SYSTEM
}

model AcademicWeighting {
  id Int @id @default(autoincrement())

  academicYear String

  termId Int
  term   SchoolTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  gradeId Int
  grade   Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  gradingScaleId Int
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)

  assignmentWeight Float @default(0)
  assessmentWeight Float @default(30)
  examWeight       Float @default(70)

  assessmentScoreStrategy AssessmentScoreStrategy @default(AVERAGE)

  passMark Float @default(50)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYear, termId, gradeId], name: "academicYear_termId_gradeId")
  @@index([termId])
  @@index([gradeId])
  @@index([gradingScaleId])
  @@index([academicYear])
  @@index([isActive])
}

model GradingScale {
  id Int @id @default(autoincrement())

  name        String
  description String?

  status    GradingScaleStatus @default(DRAFT)
  isDefault Boolean            @default(false)

  boundaries         GradeBoundary[]
  academicWeightings AcademicWeighting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([status])
  @@index([isDefault])
}

model GradeBoundary {
  id Int @id @default(autoincrement())

  gradingScaleId Int
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  grade String

  minimumScore Float
  maximumScore Float

  remark String

  gradePoint Float?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradingScaleId, grade], name: "gradingScaleId_grade")
  @@index([gradingScaleId])
  @@index([minimumScore, maximumScore])
  @@index([position])
}

model ReportCard {
  id Int @id @default(autoincrement())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Restrict)

  gradeId Int
  grade   Grade @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  termId Int
  term   SchoolTerm @relation(fields: [termId], references: [id], onDelete: Restrict)

  academicYear String

  status            ReportCardStatus            @default(DRAFT)
  calculationStatus ReportCardCalculationStatus @default(BLOCKED)

  version Int @default(1)

  /**
   * Source IDs are retained for traceability, but they are
   * deliberately not foreign keys. The report card remains
   * valid even if an old configuration is later archived.
   */
  sourceWeightingId    Int?
  sourceGradingScaleId Int?

  subjectCount           Int @default(0)
  completedSubjectCount  Int @default(0)
  incompleteSubjectCount Int @default(0)

  totalScore   Float  @default(0)
  averageScore Float?

  highestSubjectScore Float?
  lowestSubjectScore  Float?

  passedSubjectCount Int    @default(0)
  failedSubjectCount Int    @default(0)
  passRate           Float?

  totalGradePoints  Float?
  averageGradePoint Float?

  overallGrade      String?
  overallRemark     String?
  overallGradePoint Float?

  overallPosition   Int?
  classStudentCount Int?

  daysSchoolOpened     Int?
  daysPresent          Int?
  daysAbsent           Int?
  attendancePercentage Float?

  conduct            String?
  classTeacherRemark String?
  headTeacherRemark  String?
  promotionStatus    String?
  nextTermBegins     DateTime?

  /**
   * These JSON fields preserve the exact rules and calculated
   * report data used at generation time.
   */
  weightingSnapshot    Json
  gradingScaleSnapshot Json
  reportSnapshot       Json
  calculationIssues    Json

  generatedAt   DateTime  @default(now())
  regeneratedAt DateTime?
  publishedAt   DateTime?
  lockedAt      DateTime?
  archivedAt    DateTime?

  generatedById String?
  publishedById String?

  isStale     Boolean   @default(false)
  staleAt     DateTime?
  staleReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects ReportCardSubject[]

  reviewStatus ReportCardReviewStatus @default(DRAFT)

  /**
   * Review submission
   * Actor IDs are Clerk user IDs. We use plain strings here
   * because administrators may not have Teacher records.
   */
  submittedForReviewAt DateTime?
  submittedForReviewBy String?

  /**
   * Approval
   */
  approvedAt DateTime?
  approvedBy String?

  /**
   * When an administrator returns the report for correction.
   */
  changesRequestedAt DateTime?
  changesRequestedBy String?
  reviewNote         String?

  /**
   * Additional student development fields inspired by
   * the sample report card.
   */
  attitude String?
  interest String?

  /**
   * Optional editable academic-period details.
   */
  termClosedOn DateTime?

  /**
   * Signature and stamp snapshots.
   * These will later preserve the exact names/images used
   * when a card is published.
   */
  classTeacherNameSnapshot String?
  classTeacherSignatureUrl String?

  headTeacherNameSnapshot String?
  headTeacherSignatureUrl String?

  schoolStampUrl String?

  /**
   * Publication audit information.
   */
  publishedBy String?

  /**
   * Existing fields from the earlier build should remain:
   * daysSchoolOpened
   * daysPresent
   * daysAbsent
   * attendancePercentage
   * conduct
   * classTeacherRemark
   * headTeacherRemark
   * promotionStatus
   * nextTermBegins
   * publishedAt
   * lockedAt
   * archivedAt
   */

  activities ReportCardActivity[]

  @@unique([studentId, academicYear, termId, classId])
  @@index([academicYear, termId, classId])
  @@index([studentId, status])
  @@index([classId, academicYear, termId, status])
  @@index([reviewStatus])
  @@index([status, reviewStatus])
  @@index([isStale])
  @@index([classId, academicYear, termId, isStale])
}

model ReportCardSubject {
  id Int @id @default(autoincrement())

  reportCardId Int
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  subjectName String
  teacherId   String?
  teacherName String?

  assignmentPercentage Float?
  assignmentWeight     Float
  assignmentScore      Float

  assessmentPercentage Float?
  assessmentWeight     Float
  assessmentScore      Float

  examinationPercentage Float?
  examinationWeight     Float
  examinationScore      Float

  finalScore Float

  grade      String
  remark     String
  gradePoint Float?

  passed Boolean

  calculationStatus ReportCardCalculationStatus

  subjectPosition Int?
  classAverage    Float?
  highestScore    Float?
  lowestScore     Float?

  categorySnapshot  Json
  weightedSnapshot  Json
  gradingSnapshot   Json
  calculationIssues Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportCardId, subjectId])
  @@index([subjectId, reportCardId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum ResultType {
  EXAM
  ASSIGNMENT
  ASSESSMENT
}

enum FeeStatus {
  PAID
  PARTIAL
  PENDING
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CHEQUE
}

model SchoolTerm {
  id        Int      @id @default(autoincrement())
  name      TermName
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  daysSchoolOpened Int?

  academicYearId Int?
  academicYear   SchoolAcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  assessments Assessment[]
  exams       Exam[]       @relation("ExamSchoolTerm")
  assignments Assignment[]

  academicWeightings AcademicWeighting[]

  reportCards ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@index([isActive])
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

model SchoolAcademicYear {
  id Int @id @default(autoincrement())

  name String @unique

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(false)

  terms SchoolTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startDate])
}

